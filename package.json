{
  "name": "morphio",
  "productName": "Morphio",
  "version": "0.2.0",
  "description": "Локальный конвертер форматов, удаление фона и GIF-студия для Windows",
  "main": "./out/main/index.js",
  "author": "Morphio",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "icons": "node scripts/make-icon.mjs",
    "i18n": "node scripts/check-i18n.mjs",
    "cli": "node scripts/cli.cjs",
    "ui": "vite --config vite.ui.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run i18n && npm test"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "7zip-bin": "^5.2.0",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.1.0",
    "onnxruntime-node": "^1.31.1",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
